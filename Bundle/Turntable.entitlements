<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime blocks outgoing Apple Events without this. Required for
	     both the ad-hoc dev signature and a notarized Developer ID build. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>

	<!-- App Sandbox is deliberately off: direct distribution, and setting the desktop
	     wallpaper via NSWorkspace is simplest unsandboxed. -->
</dict>
</plist>
